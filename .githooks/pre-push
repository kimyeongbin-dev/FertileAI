#!/usr/bin/env bash
# main / dev 로 임시 커밋·AI 트레일러가 들어가는 push 차단 — 규칙: CONTRIBUTING.md 2-5, 2-6
set -euo pipefail
. "$(dirname "$0")/_common.sh"

remote="$1"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/main | refs/heads/dev) ;; *) continue ;; esac
  [[ "$local_sha" =~ ^0+$ ]] && continue   # 브랜치 삭제

  if [[ "$remote_sha" =~ ^0+$ ]]; then
    commits="$(git rev-list "$local_sha" --not --remotes="$remote")"
  else
    commits="$(git rev-list "$remote_sha..$local_sha")"
  fi

  for c in $commits; do
    subject="$(git log -1 --format=%s "$c")"
    if printf '%s' "$subject" | grep -qiE "$TEMP_COMMIT_PATTERN"; then
      printf '✖ %s 에 임시 커밋 push 불가: %s %s\n' "${remote_ref#refs/heads/}" "${c:0:7}" "$subject" >&2
      blocked=1
    fi
    if git log -1 --format=%B "$c" | grep -qiE "$AI_TRAILER_PATTERN"; then
      printf '✖ %s 에 AI 트레일러가 있는 커밋 push 불가: %s %s\n' "${remote_ref#refs/heads/}" "${c:0:7}" "$subject" >&2
      blocked=1
    fi
  done
done

if [ "$blocked" -ne 0 ]; then
  printf '\n  git rebase -i --autosquash 로 정리한 뒤 다시 push 하세요. (CONTRIBUTING.md 2-6)\n\n' >&2
  exit 1
fi
